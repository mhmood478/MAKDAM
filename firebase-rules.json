{
  "rules": {
    ".read": false,
    ".write": false,
    "families": {
      "$familyId": {
        ".read": true,
        ".write": true,
        "people": {
          "$personId": {
            ".validate": "newData.hasChildren(['name','gender','relation','createdAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 80 && (newData.child('gender').val() === 'male' || newData.child('gender').val() === 'female')"
          }
        }
      }
    }
  }
}